[Unit]
Description=SmartElectric FastAPI REST Backend Service
After=network.target smartelectric-worker.service
Wants=smartelectric-worker.service

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/smartelectric/edge/backend
Environment=PYTHONUNBUFFERED=1
# Executing uvicorn from absolute path or using python module execution
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartelectric-api

[Install]
WantedBy=multi-user.target
